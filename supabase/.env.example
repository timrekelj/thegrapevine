# Copy to supabase/.env.local (gitignored). Never commit real keys.
MISTRAL_API_KEY=your-mistral-api-key
# OpenAI Decisions API (gpt-6-luna) — same-event/conflict clustering decisions
OPENAI_API_KEY=your-openai-api-key
# Server-only OneSignal App API key and a random database-webhook secret.
ONESIGNAL_REST_API_KEY=your-onesignal-app-api-key
PUSH_WEBHOOK_SECRET=your-random-webhook-secret
# Set true only on hosted production functions; local telemetry stays disabled.
POSTHOG_ENABLED=false
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.
