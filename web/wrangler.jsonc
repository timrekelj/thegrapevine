{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "thegrapevine",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // The worker calls itself for cache revalidation; must match "name" above.
    { "binding": "WORKER_SELF_REFERENCE", "service": "thegrapevine" }
  ],
  // Runtime values; the NEXT_PUBLIC_ ones must also be set as build variables, since Next inlines them at build time.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://thegrapevine.si",
    "NEXT_PUBLIC_SUPABASE_URL": "https://ivjaenrmhsqnsvzemoez.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_oT-H6EAfuoNp8dcVdTHJow_l1-Skd1C"
  },
  "observability": { "enabled": true }
}
