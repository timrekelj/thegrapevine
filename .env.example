# Mistral — language model + embeddings (https://console.mistral.ai)
MISTRAL_API_KEY=
# GIPHY — GIF search (free key at https://developers.giphy.com)
GIPHY_API_KEY=
# Supabase — local dev defaults; `supabase start` prints the real values
SUPABASE_URL=http://localhost:55321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Web — build-time public values (also set as Vercel env vars)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical site origin; used to build OAuth callback URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional local OAuth: fill these and enable each provider in supabase/config.toml.
# Hosted credentials belong in Supabase Authentication → Sign In / Providers, not Vercel or the apps.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_X_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_X_SECRET=
