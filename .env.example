# Mistral — language model + embeddings (https://console.mistral.ai)
MISTRAL_API_KEY=
# GIPHY — GIF search (free key at https://developers.giphy.com)
GIPHY_API_KEY=
# Local decision-model inference service (Strands Decider 2B)
MODEL_SERVER_URL=http://localhost:8100
# Supabase — local dev defaults; `supabase start` prints the real values
SUPABASE_URL=http://localhost:55321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Web — build-time public values (also set as Vercel env vars)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical site origin; used to build magic-link callback URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
